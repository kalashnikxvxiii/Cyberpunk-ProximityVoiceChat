+/// "remove", "party on|off", "net <jitter ms> <loss %>", "echo on|off" (our voice back through NightCoop).
+fn test(cmd: String) -> String {
+    with(|s| {
+        let pose = s.lock(&s.pose).map(|p| p.pos());
+        // It stands as we do now: same ear height.
+        let env = vc_protocol::Env {
+            ear: vc_protocol::Env::ear_cm(s.ear()),
+            ..s.surroundings().map_or(vc_protocol::Env::default(), |e| e.to_env())
+        };
+        let mut c = s.lock(&s.test);
+        let mut words = cmd.split_whitespace();
