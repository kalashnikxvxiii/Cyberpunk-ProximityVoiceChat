+-- Which collision groups a ray straight ahead of the camera hits, and how
+-- far: to find out in game what a shop window or a table is made of.
+function A.probeGroups()
+    local player = Game.GetPlayer()
+    local space = Game.GetSpatialQueriesSystem()
+    if not player or not space then
+        return {}
+    end
+    local f = Game.GetCameraSystem():GetActiveCameraForward()
+    local a = head(player:GetWorldPosition(), A.ear)
+    local b = { x = a.x + f.x * 30, y = a.y + f.y * 30, z = a.z + f.z * 30 }
+    local out = {}
+    for _, name in ipairs(PROBE_NAMES) do
+        local ok, hitOk, res = pcall(function()
+            return space:SyncRaycastByCollisionGroup(v4(a.x, a.y, a.z), v4(b.x, b.y, b.z), CName.new(name), false, false)
+        end)
+        local d = nil
+        if ok and hitOk and res and res.position and not (res.position.x == 0 and res.position.y == 0 and res.position.z == 0) then
+            d = dist(a, res.position)
+        end
+        out[#out + 1] = { name = name, dist = d, err = not ok and tostring(hitOk) or nil }
+    end
+    return out
+end
