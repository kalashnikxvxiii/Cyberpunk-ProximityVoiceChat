+-- The pretend partner (testing alone): "record", "stop", "place", "remove",
+-- "party on|off", "net <jitter ms> <loss %>", "echo on|off". Returns "" or the error.
+function api.test(cmd)
+    return call("VoiceChat_Test", cmd) or ""
+end
+
+function api.testStatus()
+    local f = split(call("VoiceChat_TestStatus") or "")
+    local t = {
+        status = f[1] or "",
+        party = f[2] == "1",
+        jitter = tonumber(f[3]) or 0,
+        loss = tonumber(f[4]) or 0,
+        echo = f[5] == "1",
+    }
+    if f[8] then
+        t.at = { x = tonumber(f[6]), y = tonumber(f[7]), z = tonumber(f[8]) }
+        t.loud, t.reach = tonumber(f[9]) or 0, tonumber(f[10]) or 0
+    end
+    return t
+end
+
 -- Our ears above our feet (m).
 function api.setEar(m)
     call("VoiceChat_SetEar", m)
