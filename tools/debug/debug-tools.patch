+            },
+            (Some("remove"), ..) => c.at = None,
+            (Some("party"), Some(v), _) => c.party = v == "on",
+            (Some("echo"), Some(v), _) => c.coop_echo = v == "on",
+            (Some("net"), Some(j), Some(l)) => {
+                c.jitter_ms = j.parse::<f32>().unwrap_or(30.0).clamp(0.0, 500.0);
+                c.loss_pct = l.parse::<f32>().unwrap_or(0.0).clamp(0.0, 100.0);
+            }
+            _ => return format!("? {cmd}"),
+        }
+        String::new()
+    })
+}
