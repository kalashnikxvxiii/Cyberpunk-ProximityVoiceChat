diff --git a/crates/plugin/src/testvoice.rs b/crates/plugin/src/testvoice.rs
new file mode 100644
index 0000000..a7e1b89
--- /dev/null
+++ b/crates/plugin/src/testvoice.rs
@@ -0,0 +1,200 @@
+//! A pretend partner, for testing alone: your own recorded voice, played from
+//! where you left it. It goes through everything a real partner's voice goes
+//! through once it arrives (jitter buffer, decoder, walls and openings,
+//! distance, reverb, shouting, noise), delivered the way NightCoop does: two
+//! frames per message every 40 ms, each message late by a random jitter, some
+//! lost. Only the network between two games is left out (the chat's tests
+//! cover that).
+
+use std::collections::VecDeque;
+use std::time::{Duration, Instant};
+
+use vc_dsp::spatial::Shout;
+use vc_dsp::{FRAME, RATE, rms_db};
+use vc_protocol::{Env, PlayerId, Vec3};
+
+/// Its id among the speakers.
+pub const TEST_ID: PlayerId = PlayerId::MAX - 1;
+const MAX_CLIP: Duration = Duration::from_secs(10);
+const MESSAGE: Duration = Duration::from_millis(40);
+/// Messages of silence between two plays of the clip (1 s).
+const PAUSE_MESSAGES: usize = 25;
+
+/// What the UI asks for; read by the audio thread.
+#[derive(Debug, Clone, Default)]
+pub struct Control {
+    /// Start a recording (taken by the audio thread).
+    pub record: bool,
+    /// Stop the recording early.
+    pub stop_record: bool,
+    /// Where it stands (feet), and the surroundings there when placed; `None`: silent.
+    pub at: Option<(Vec3, Env)>,
+    pub party: bool,
+    /// Our own voice back through the NightCoop chat (see `vc_coop::chat::Game::echo`).
+    pub coop_echo: bool,
+    /// Extra delay of each message, up to this many ms.
+    pub jitter_ms: f32,
+    /// Messages lost, percent.
+    pub loss_pct: f32,
+    /// For the UI.
+    pub status: String,
+    /// For the UI: how much over the usual voice it plays now (dB), and how far it carries here (m).
+    pub reach: (u8, f32),
+}
+
+/// A frame as it arrives: (seq, opus, loud dB).
+pub type Arrival = (u32, Vec<u8>, u8);
+
+#[derive(Default)]
+pub struct TestVoice {
+    recording: Option<Vec<f32>>,
+    clip: Vec<(Vec<u8>, u8)>,
+    /// Next clip frame, or (past the end) a pause.
+    next: usize,
+    pause: usize,
+    seq: u32,
+    made_at: Option<Instant>,
+    in_flight: VecDeque<(Instant, u32, Vec<u8>, u8)>,
+    rng: u32,
+}
+
+impl TestVoice {
+    /// Follows the UI; returns the status line.
+    pub fn control(&mut self, c: &mut Control) -> String {
+        if std::mem::take(&mut c.record) {
+            self.recording = Some(Vec::with_capacity(RATE as usize * MAX_CLIP.as_secs() as usize));
+        }
+        let full = self.recording.as_ref().is_some_and(|r| r.len() >= RATE as usize * MAX_CLIP.as_secs() as usize);
+        if (std::mem::take(&mut c.stop_record) || full)
+            && let Some(pcm) = self.recording.take()
+        {
+            self.clip = encode(&pcm).unwrap_or_default();
+            (self.next, self.pause) = (0, 0);
+        }
+        let secs = |frames: usize| frames as f32 * FRAME as f32 / RATE as f32;
+        match (&self.recording, &c.at) {
+            (Some(r), _) => crate::tr!("registro… {:.1} s", "recording… {:.1} s", r.len() as f32 / RATE as f32),
+            (None, _) if self.clip.is_empty() => crate::tr!("nessuna registrazione", "nothing recorded"),
+            (None, None) => crate::tr!("registrazione di {:.1} s, non piazzata", "{:.1} s recorded, not placed", secs(self.clip.len())),
+            (None, Some((p, _))) => crate::tr!(
+                "suona da ({:.0}, {:.0}, {:.0}), {:.1} s in loop",
+                "playing from ({:.0}, {:.0}, {:.0}), {:.1} s looped",
+                p[0],
+                p[1],
+                p[2],
+                secs(self.clip.len())
+            ),
+        }
+    }
+
+    /// 10 ms of our processed microphone, while recording.
+    pub fn record(&mut self, half: &[f32]) {
+        if let Some(r) = &mut self.recording {
+            r.extend_from_slice(half);
+        }
+    }
+
+    fn random(&mut self) -> f32 {
+        self.rng = self.rng.wrapping_mul(1_664_525).wrapping_add(1_013_904_223);
+        (self.rng >> 8) as f32 / (1u32 << 24) as f32
+    }
+
+    /// The frames that arrive by `now`.
+    pub fn arrivals(&mut self, c: &Control, now: Instant, out: &mut Vec<Arrival>) {
+        if c.at.is_none() || self.clip.is_empty() || self.recording.is_some() {
+            self.made_at = None;
+            self.in_flight.clear();
+            return;
+        }
+        let mut t = *self.made_at.get_or_insert(now);
+        if now.duration_since(t) > Duration::from_millis(250) {
+            t = now; // we stalled: don't send a burst of old audio
+        }
+        while t + MESSAGE <= now {
+            t += MESSAGE;
+            let lost = self.random() * 100.0 < c.loss_pct;
+            let late = Duration::from_secs_f32(self.random() * c.jitter_ms.max(0.0) / 1000.0);
+            for _ in 0..2 {
+                let seq = self.seq;
+                self.seq = self.seq.wrapping_add(1);
+                if self.next >= self.clip.len() {
+                    // A pause between plays: nothing sent, as with a quiet speaker.
+                    self.pause += 1;
+                    if self.pause >= 2 * PAUSE_MESSAGES {
+                        (self.next, self.pause) = (0, 0);
+                    }
+                    continue;
+                }
+                let (opus, loud) = self.clip[self.next].clone();
+                self.next += 1;
+                if !lost {
+                    self.in_flight.push_back((t + late, seq, opus, loud));
+                }
+            }
+        }
+        self.made_at = Some(t);
+        let mut keep = VecDeque::new();
+        for m in self.in_flight.drain(..) {
+            if m.0 <= now { out.push((m.1, m.2, m.3)) } else { keep.push_back(m) }
+        }
+        self.in_flight = keep;
+    }
+}
+
+/// Opus frames as the sender makes them, each with how loud it is over the usual voice.
+fn encode(pcm: &[f32]) -> Result<Vec<(Vec<u8>, u8)>, String> {
+    let mut enc = opus::Encoder::new(RATE, opus::Channels::Mono, opus::Application::Voip).map_err(|e| e.to_string())?;
+    enc.set_bitrate(opus::Bitrate::Bits(crate::audio::OPUS_BITRATE)).map_err(|e| e.to_string())?;
+    // The usual voice is what most of the speech in the clip sounds like (the calm part).
+    let mut peaks = Shout::default();
+    let mut speech: Vec<f32> =
+        pcm.chunks_exact(FRAME).map(rms_db).filter(|d| *d > -60.0).map(|d| peaks.peak(d)).collect();
+    speech.sort_by(f32::total_cmp);
+    let usual = speech.get(speech.len() * 2 / 5).copied().unwrap_or(-30.0);
+    let mut shout = Shout::with_usual(usual);
+    let mut packet = [0u8; 1000];
+    let mut out = Vec::new();
+    for f in pcm.chunks_exact(FRAME) {
+        let loud = shout.push(rms_db(f)).round().min(255.0) as u8;
+        let n = enc.encode_float(f, &mut packet).map_err(|e| e.to_string())?;
+        out.push((packet[..n].to_vec(), loud));
+    }
+    Ok(out)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_clip_of_talk_then_shout_reads_calm_then_loud() {
+        // A quiet breath, 5 s of calm talk at about -30 dBFS, 3 s of shouting at -12.
+        let tone = |amp: f32, secs: f32| -> Vec<f32> {
+            (0..(secs * RATE as f32) as usize).map(|i| amp * (i as f32 * 0.05).sin() * (1.0 + (i as f32 * 0.0008).sin()) * 0.5).collect()
+        };
+        let mut pcm = tone(0.004, 0.5);
+        pcm.extend(tone(0.045, 5.0));
+        pcm.extend(tone(0.36, 3.0));
+        let clip = encode(&pcm).unwrap();
+        let calm = clip[25..275].iter().map(|c| c.1).max().unwrap();
+        let shout = clip[300..].iter().map(|c| c.1).max().unwrap();
+        assert!(calm <= 1, "calm talk read as +{calm} dB");
+        assert!(shout >= 12, "shout read as +{shout} dB");
+    }
+
+    #[test]
+    fn arrives_two_by_two_late_and_lossy() {
+        let mut v = TestVoice { clip: vec![(vec![1], 0); 100], ..TestVoice::default() };
+        let c = Control { at: Some(([0.0; 3], Env::default())), jitter_ms: 30.0, loss_pct: 20.0, ..Control::default() };
+        let start = Instant::now();
+        let mut got = Vec::new();
+        for ms in (0..=2000).step_by(5) {
+            v.arrivals(&c, start + Duration::from_millis(ms), &mut got);
+        }
+        // 2 s = 50 messages = 100 frames made, about a fifth lost, all of them by 2 s + jitter.
+        assert!((60..=96).contains(&got.len()), "{}", got.len());
+        let seqs: Vec<u32> = got.iter().map(|g| g.0).collect();
+        assert!(seqs.windows(2).any(|w| w[1] < w[0]) || c.jitter_ms < 41.0, "jitter can reorder");
+        assert!(seqs.iter().all(|&s| s < 100));
+    }
+}
